APP_NAME=OptiEntry
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
# Database identifiers keep the former product name so existing databases keep working.
DB_DATABASE=optiaccounting
DB_USERNAME=optiaccounting
DB_PASSWORD=optiaccounting

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend origin allowed by CORS / used in links
FRONTEND_URL=http://localhost:5173

# Identity mode: standalone (default) or optinexus (docs/architecture/SAAS_ARCHITECTURE.md)
OPTIENTRY_IDENTITY_MODE=standalone

# --- OptiNexus adapter (only when OPTIENTRY_IDENTITY_MODE=optinexus; docs/integration/OPTINEXUS_ONBOARDING.md)
OPTINEXUS_BASE_URL=
# Registered identifier from before the OptiEntry rename; keep it for an existing registration (a new registration may choose another code).
OPTINEXUS_APPLICATION_CODE=optiaccounting
# OIDC client (sign-in) and service account (permissions, entitlements, events) created in OptiNexus
OPTINEXUS_SSO_CLIENT_ID=
OPTINEXUS_SSO_CLIENT_SECRET=
OPTINEXUS_SSO_REDIRECT_URI=
OPTINEXUS_SSO_FRONTEND_URL=
OPTINEXUS_SERVICE_CLIENT_ID=
OPTINEXUS_SERVICE_CLIENT_SECRET=
OPTINEXUS_BREAK_GLASS_LOGIN=true
OPTINEXUS_PROVISION_TENANTS=true
OPTINEXUS_PERMISSION_TTL=300
OPTINEXUS_ENTITLEMENT_TTL=300
