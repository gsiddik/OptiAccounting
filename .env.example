# OptiEntry container runtime: copy to .env (never commit it). Compose reads this file for ${...} interpolation only; the containers get
# exactly the values passed in docker-compose.yml. After changing a value run `docker compose up -d`; no image rebuild is needed.
#
# Required (Compose refuses to start without them):
#   APP_KEY      base64: + 32 random bytes, e.g.  echo "base64:$(openssl rand -base64 32)"
#                (PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); "base64:" + [Convert]::ToBase64String($b))
#   DB_PASSWORD  a long random string (an existing installation keeps the password its database already uses)
APP_KEY=
DB_PASSWORD=

# Origin the browser uses for the console (it also serves /api). Also the OIDC redirect origin when signing in through OptiNexus.
ENTRY_PUBLIC_URL=http://localhost:5190

# Host ports and the address they are published on (127.0.0.1 = this machine only).
BIND_ADDRESS=127.0.0.1
ENTRY_API_PORT=8200
ENTRY_UI_PORT=5190

# standalone = OptiEntry runs without OptiNexus (local sign-in); optinexus = OptiNexus is the identity and governance authority.
OPTIENTRY_IDENTITY_MODE=standalone

# --- OptiNexus adapter (only when OPTIENTRY_IDENTITY_MODE=optinexus; docs/integration/OPTINEXUS_ONBOARDING.md)
# Must be the OIDC issuer exactly as OptiNexus publishes it, reachable from this container and from the browser.
OPTINEXUS_BASE_URL=
OPTINEXUS_APPLICATION_CODE=optiaccounting
OPTINEXUS_SSO_CLIENT_ID=
OPTINEXUS_SSO_CLIENT_SECRET=
OPTINEXUS_SERVICE_CLIENT_ID=
OPTINEXUS_SERVICE_CLIENT_SECRET=

# Optional
APP_ENV=production
APP_DEBUG=false
DB_DATABASE=optiaccounting
DB_USERNAME=optiaccounting
CLIENT_MAX_BODY_SIZE=20m
